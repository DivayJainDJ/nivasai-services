# Application Configuration
APP_NAME=NivasAI Backend
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Firebase Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps Configuration
GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Google Document AI Configuration
DOCUMENT_AI_PROJECT_ID=your_gcp_project_id
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=your_document_ai_processor_id

# BigQuery Configuration
BIGQUERY_DATASET=nivasai_analytics

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
FIREBASE_PROJECT_ID=nivasai-app
FIREBASE_DATABASE_URL=https://nivasai-app.firebaseio.com

# Service Configuration
NODE_ENV=development
LOG_LEVEL=info

# Rate Limiting
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Notification Configuration
FCM_MAX_BATCH_SIZE=500
